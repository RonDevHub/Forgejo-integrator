{
  "name": "forgejo-integrator",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit && esbuild main.ts --bundle --external:obsidian --format=cjs --target=es2020 --outfile=main.js",
    "dev": "esbuild main.ts --bundle --external:obsidian --format=cjs --target=es2020 --outfile=main.js --watch"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "typescript": "^5.0.0"
  }
}